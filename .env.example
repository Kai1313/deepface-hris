# DeepFace API config (loaded by the container)

# Preload the recognition model at startup instead of on the first request.
# Facenet is the pragmatic pick: small-ish (~100MB) and accurate.
# First boot downloads weights into the volume; later boots are instant.
DEEPFACE_FACE_RECOGNITION_MODELS=Facenet

# Optional: require `Authorization: Bearer <token>` on every request.
# Leave commented out for an open API on your internal network.
# DEEPFACE_AUTH_TOKEN=change-me
